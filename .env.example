# ==============================================================================
# HoneyNet Environment Configuration Template (Placeholders Only - Safe to Commit)
# ==============================================================================

# Server & Security Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
JSON_LOGS=true
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
WS_AUTH_TOKEN=change_me_to_a_secure_token_in_production
RATE_LIMIT_PER_MINUTE=120

# Database (Local MongoDB or MongoDB Atlas URI)
# Local Docker: mongodb://localhost:27017/honeynet_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/honeynet_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/honeynet_db
DATABASE_NAME=honeynet_db

# Native Ollama AI Engine (Apple Silicon / Local Host)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=2.0

# Cowrie Honeypot Log Path
COWRIE_LOG_PATH=./cowrie_logs/cowrie.json
