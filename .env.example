# HoneyNet Local Configuration Example
# Copy this file to .env for local customization (do not commit .env)

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=5.0

# Paths
HONEYNET_DB_PATH=honeynet.db
COWRIE_LOG_PATH=cowrie_logs/cowrie.json
